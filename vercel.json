{
  "version": 2,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/(ar|de|fr)/blog/(.*)",
      "destination": "/article-shell.html"
    },
    {
      "source": "/blog/(.*)",
      "destination": "/article-shell.html"
    },
    {
      "source": "/(ar|de|fr)/projects/(.*)",
      "destination": "/article-shell.html"
    },
    {
      "source": "/projects/(.*)",
      "destination": "/article-shell.html"
    },
    {
      "source": "/(ar|de|fr)/q/(.*)",
      "destination": "/article-shell.html"
    },
    {
      "source": "/q/(.*)",
      "destination": "/article-shell.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(favicon.svg|favicon.ico|apple-touch-icon.png|icon-192.png|icon-512.png|site.webmanifest|icons.svg|logo-icon.png|founder.jpg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/(sitemap.xml|robots.txt)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/((?!assets/).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/i18n/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    }
  ],
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "query",
          "key": "lang",
          "value": "(?<lng>ar|de|fr)"
        }
      ],
      "destination": "/:lng/:path*",
      "permanent": true
    }
  ]
}
